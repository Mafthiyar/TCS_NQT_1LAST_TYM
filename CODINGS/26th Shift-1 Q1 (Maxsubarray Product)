import java.util.*;

class a {
    public static void main(String[] args) {
        int arr[] = {-1, 2, 3, 4};

        int r = arr[0];
        int max = arr[0];
        int min = arr[0];

        for(int i=1; i<arr.length; i++){
            int kmax = Math.max(arr[i], Math.max(arr[i] * max,arr[i] * min));
            int kmin = Math.max(arr[i], Math.min(arr[i] * max, arr[i] * min));

            max = kmax;
            min = kmin;

            r = Math.max(r,max);
        }
        System.out.println(r);

            
    }
}
