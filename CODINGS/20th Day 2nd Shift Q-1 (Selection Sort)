import java.util.*;

class gymFee{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        int arr[][] = new int[n][2];

        for(int i=0; i<n; i++){
            arr[i][0] = sc.nextInt();
            arr[i][1] = sc.nextInt();
        }

        for(int i=0; i<n; i++){
            int min = i;

            for(int j=i+1; j<n; j++){
                if(arr[j][0] < arr[min][0]){
                    min = j;
                }else if(arr[j][0] == arr[min][0]){
                    if(arr[j][1] < arr[min][1]){
                        min = j;
                    }
                }
            }

            int temp1 = arr[i][0];
            int temp2 = arr[i][1];

            arr[i][0] = arr[min][0];
            arr[i][1] = arr[min][1];


            arr[min][0] = temp1;
            arr[min][1] = temp2;


            System.out.println(arr[i][0] + "  " + arr[i][1]);
        }




    }
}
