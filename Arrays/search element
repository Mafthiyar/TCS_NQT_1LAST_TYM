import java.util.*;

class solution{
    public static void main(String[] args){
        int arr[] = {2,3,2,1,4};
        int key = 4;

        boolean found = false;
        int k = 0;

        for(int i=0; i<arr.length; i++){
            if(arr[i] == key){
                k = arr[i];
                found = true;
                break;
            }
        }

        if(found){
            System.out.println("found : " + k);
        }else{
            System.out.println("not found");
        }
    }
}
