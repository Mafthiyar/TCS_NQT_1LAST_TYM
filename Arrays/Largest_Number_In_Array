import java.util.*;

class solution{
    public static void main(String[] args){

        int arr[] = {3,5,7};

        int max  = arr[0];
        int n = arr.length;
        for(int i=1; i<n; i++){
            if(max < arr[i]){
                max = arr[i];
            }
        }
        System.out.print(max);
    }
}
