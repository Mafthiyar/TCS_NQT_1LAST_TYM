int arr[] = {1,4,1,1,2,5,2,3,5,7};
int index = 0;

for(int i=0; i<arr.length; i++){
    boolean visited = false;

    for(int j=0; j<i; j++){
        if(arr[i] == arr[j]){
            visited = true;
            break;
        }
    }

    if(!visited){
        arr[index] = arr[i];
        index++;
    }
}

for(int i=0; i<index; i++){
    System.out.print(arr[i] + " ");
}
