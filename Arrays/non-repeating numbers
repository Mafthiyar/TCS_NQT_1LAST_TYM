import java.util.*;

class removeDuplicates{
    public static void main(String[] args){
        int arr[] = {1,4,1,1,2,5,2,3,5,7};

        for(int i=0; i<arr.length; i++){
            boolean visited = false;
            int index = 0;

            for(int j=0; j<i; j++){
                if(arr[i] == arr[j]) {
                    visited = true;
                    break;
                }
            }

            if(visited)
                continue;


            for(int k=0; k<arr.length; k++){
                if(arr[i] == arr[k]){
                    index++;
                }
            }

            if(index == 1){
                System.out.print(arr[i] + " ");
            }
        }


    }
}
