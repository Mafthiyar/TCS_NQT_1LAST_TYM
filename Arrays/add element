import java.util.*;

class addElement{
    public static void main(String[] args){
        int arr[] = {1,2,3,4,5};
        int d = 6;

        int k[] = new int[arr.length+1];

        for(int i=0; i<arr.length; i++){
            k[i] = arr[i];
        }

        k[arr.length] = d;

        for(int i=0; i<k.length; i++){
            System.out.print(k[i] + " ");
        }




    }
}
