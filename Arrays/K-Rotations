import java.util.*;

import static java.util.Arrays.sort;

class Krotations {
    public static void reverse(int[] arr,int l,int r) {

        while (l < r) {
            int temp = arr[l];
            arr[l] = arr[r];
            arr[r] = temp;
            l++;
            r--;
        }
    }

        public static void main (String[]args){
            int arr[] = {1, 2, 3, 4, 5};
            int k =3;
            int n = arr.length;

            reverse(arr,0,n-1);
            reverse(arr,0,k-1);
            reverse(arr,k,n-1);

            for(int s : arr){
                System.out.print(" " + s);

        }
    }
}
