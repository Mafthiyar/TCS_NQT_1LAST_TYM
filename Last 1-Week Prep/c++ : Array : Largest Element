#include <iostream>
#include <array>
#include <algorithm>

int main(){
    std::array<int,4> arr = {4,7,8,2};
    int max = arr[0];
    
    int l = arr.size();
    
    for(int i=1; i<l; i++){
        if(arr[i] > max){
            max = arr[i];
        }
    }
    
    std::cout<< max << " ";
    return 0;
}
