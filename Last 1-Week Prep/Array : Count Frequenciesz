import java.util.*;

class countFrequencies{
    public static void main(String[] args){
        int arr[] = {3, 2, 1, 2, 4};

        for(int i=0; i<arr.length; i++){
            int count = 0;
            boolean visited = false;

            for(int j=0; j<i; j++) {
                if (arr[i] == arr[j]) {
                    visited = true;
                    break;
                }
            }

                if(visited) continue;

                for(int k=0; k<arr.length; k++){
                    if(arr[i] == arr[k]){
                        count++;
                    }
                }

            System.out.println(arr[i] + " " + count);
        }
    }
}
