import java.util.*;
class equilibrium{
        public static void main (String[]args){
            int arr[] = {1, 3, 4, 2, 2,4};

            Arrays.sort(arr);

            int n =arr.length;

            double median;

            if(n % 2 == 1) {

                median = arr[n/2];

            }else{

                median = (arr[n/2]+ arr[n/2-1])/2.0;
            }

            System.out.println(median + " ");

    }
}
